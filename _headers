# Cloudflare Pages Headers
# https://developers.cloudflare.com/pages/platform/headers

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'

# Cache static assets (shorter cache for easier updates)
/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600

/images/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=86400

/read-later/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self' https:; media-src https: blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'

# API responses and their security headers are set by Functions middleware.

/api/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

